# Generated by iwp for site {{ name }}. Do not edit.
# FPM socket dir: root-owned so the site cannot loosen it; the site's www-data may create
# its socket (ACL; the explicit mask keeps it effective after the 0710 chmod), only the
# nginx group may enter. /run/iwp itself comes from iwp.conf.
d /run/iwp/{{ name }} 0710 root {{ nginx_group }} -
a+ /run/iwp/{{ name }} - - - - u:{{ www_uid }}:rwx,m::rwx
