# Generated by iwp for site {{ name }}. Do not edit: change the site file and run `iwp deploy {{ name }}`.
[Unit]
Description=iwp WordPress site {{ name }}
Wants=network-online.target
After=network-online.target mariadb.service

[Container]
Image={{ image }}
Pull=never
ContainerName=iwp-{{ name }}
ReadOnly=true
Tmpfs=/tmp:rw,size={{ tmp_size }},mode=1777,noexec,nosuid,nodev
Tmpfs=/run:mode=0755
DropCapability=ALL
NoNewPrivileges=true
UIDMap=0:{{ uid_base }}:65536
GIDMap=0:{{ uid_base }}:65536
SecurityLabelLevel={{ selinux_level }}
Network={{ network }}
AddHost=iwp-db-host:{{ db_host_ip }}
Secret=iwp-{{ name }}-db,type=mount,target=iwp-db,uid=33,gid=33,mode=0400
Secret=iwp-{{ name }}-salts,type=mount,target=iwp-salts,uid=33,gid=33,mode=0400
Volume={{ base }}/current/wp-content/plugins:/var/www/html/wp-content/plugins:ro
Volume={{ base }}/current/wp-content/themes:/var/www/html/wp-content/themes:ro
Volume={{ base }}/current/wp-content/mu-plugins:/var/www/html/wp-content/mu-plugins:ro
Volume={{ base }}/current/wp-content/languages:/var/www/html/wp-content/languages:ro
{% for d in dropins %}
Volume={{ base }}/current/wp-content/{{ d }}:/var/www/html/wp-content/{{ d }}:ro
{% endfor %}
# Writable mounts never map executables: a site cannot run a binary or load a library it wrote.
Volume={{ base }}/shared/uploads:/var/www/html/wp-content/uploads:rw,noexec,nosuid,nodev
{% for w in writable %}
Volume={{ base }}/shared/{{ w.shared }}:/var/www/html/{{ w.rel }}:rw,noexec,nosuid,nodev
{% endfor %}
Volume={{ base }}/config/wp-config.site.php:/etc/iwp/wp-config.site.php:ro
Volume={{ base }}/config/zz-site.ini:/usr/local/etc/php/conf.d/zz-site.ini:ro
Volume={{ base }}/config/zz-site.conf:/usr/local/etc/php-fpm.d/zz-site.conf:ro
Volume=/run/iwp/{{ name }}:/run/iwp:rw,noexec,nosuid,nodev

[Service]
MemoryMax={{ memory_max_mib }}M
OOMPolicy=continue
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
