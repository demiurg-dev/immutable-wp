# Generated by iwp for site complex. Do not edit: change the site file and run `iwp deploy complex`.
[Unit]
Description=iwp WordPress site complex
Wants=network-online.target
After=network-online.target mariadb.service

[Container]
Image=localhost/iwp-fpm:7.1.2-php8.4
Pull=never
ContainerName=iwp-complex
ReadOnly=true
Tmpfs=/tmp:rw,size=1G,mode=1777,noexec,nosuid,nodev
Tmpfs=/run:mode=0755
DropCapability=ALL
NoNewPrivileges=true
UIDMap=0:2852512:65536
GIDMap=0:2852512:65536
SecurityLabelLevel=s0:c42,c554
Network=podman
AddHost=iwp-db-host:10.88.0.1
Secret=iwp-complex-db,type=mount,target=iwp-db,uid=33,gid=33,mode=0400
Secret=iwp-complex-salts,type=mount,target=iwp-salts,uid=33,gid=33,mode=0400
Volume=/srv/sites/complex/current/wp-content/plugins:/var/www/html/wp-content/plugins:ro
Volume=/srv/sites/complex/current/wp-content/themes:/var/www/html/wp-content/themes:ro
Volume=/srv/sites/complex/current/wp-content/mu-plugins:/var/www/html/wp-content/mu-plugins:ro
Volume=/srv/sites/complex/current/wp-content/languages:/var/www/html/wp-content/languages:ro
Volume=/srv/sites/complex/current/wp-content/advanced-cache.php:/var/www/html/wp-content/advanced-cache.php:ro
Volume=/srv/sites/complex/current/wp-content/object-cache.php:/var/www/html/wp-content/object-cache.php:ro
# Writable mounts never map executables: a site cannot run a binary or load a library it wrote.
Volume=/srv/sites/complex/shared/uploads:/var/www/html/wp-content/uploads:rw,noexec,nosuid,nodev
Volume=/srv/sites/complex/shared/cache:/var/www/html/wp-content/cache:rw,noexec,nosuid,nodev
Volume=/srv/sites/complex/shared/wp-rocket-config:/var/www/html/wp-content/wp-rocket-config:rw,noexec,nosuid,nodev
Volume=/srv/sites/complex/shared/et-cache:/var/www/html/wp-content/et-cache:rw,noexec,nosuid,nodev
Volume=/srv/sites/complex/config/wp-config.site.php:/etc/iwp/wp-config.site.php:ro
Volume=/srv/sites/complex/config/zz-site.ini:/usr/local/etc/php/conf.d/zz-site.ini:ro
Volume=/srv/sites/complex/config/zz-site.conf:/usr/local/etc/php-fpm.d/zz-site.conf:ro
Volume=/run/iwp/complex:/run/iwp:rw,noexec,nosuid,nodev

[Service]
MemoryMax=5504M
OOMPolicy=continue
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
