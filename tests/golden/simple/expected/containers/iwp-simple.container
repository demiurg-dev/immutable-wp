# Generated by iwp for site simple. Do not edit: change the site file and run `iwp deploy simple`.
[Unit]
Description=iwp WordPress site simple
Wants=network-online.target
After=network-online.target mariadb.service

[Container]
Image=localhost/iwp-fpm:7.1.2-php8.3
Pull=never
ContainerName=iwp-simple
ReadOnly=true
Tmpfs=/tmp:rw,size=1G,mode=1777,noexec,nosuid,nodev
Tmpfs=/run:mode=0755
DropCapability=ALL
NoNewPrivileges=true
UIDMap=0:165536:65536
GIDMap=0:165536:65536
SecurityLabelLevel=s0:c1,c513
Network=podman
AddHost=iwp-db-host:10.88.0.1
Secret=iwp-simple-db,type=mount,target=iwp-db,uid=33,gid=33,mode=0400
Secret=iwp-simple-salts,type=mount,target=iwp-salts,uid=33,gid=33,mode=0400
Volume=/var/www/vhosts/simple/current/wp-content/plugins:/var/www/html/wp-content/plugins:ro
Volume=/var/www/vhosts/simple/current/wp-content/themes:/var/www/html/wp-content/themes:ro
Volume=/var/www/vhosts/simple/current/wp-content/mu-plugins:/var/www/html/wp-content/mu-plugins:ro
Volume=/var/www/vhosts/simple/current/wp-content/languages:/var/www/html/wp-content/languages:ro
# Writable mounts never map executables: a site cannot run a binary or load a library it wrote.
Volume=/var/www/vhosts/simple/shared/uploads:/var/www/html/wp-content/uploads:rw,noexec,nosuid,nodev
Volume=/var/www/vhosts/simple/config/wp-config.site.php:/etc/iwp/wp-config.site.php:ro
Volume=/var/www/vhosts/simple/config/zz-site.ini:/usr/local/etc/php/conf.d/zz-site.ini:ro
Volume=/var/www/vhosts/simple/config/zz-site.conf:/usr/local/etc/php-fpm.d/zz-site.conf:ro
Volume=/run/iwp/simple:/run/iwp:rw,noexec,nosuid,nodev

[Service]
MemoryMax=3968M
OOMPolicy=continue
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
